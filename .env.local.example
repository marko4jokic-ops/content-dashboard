# Copy this file to .env.local and fill in your key.
# This value is only ever read server-side (in app/api/content/route.ts).
# It must NOT be prefixed with NEXT_PUBLIC_.
WINDSOR_API_KEY=your_windsor_api_key_here

# Shared secret for the story-snapshot ingest endpoint (app/api/stories/snapshot).
# Generate one with: openssl rand -hex 32
# Required only if you want scheduled story capture (see scripts/story-snapshot.sh).
CRON_SECRET=

# Base URL scripts/story-snapshot.sh hits — defaults to http://localhost:3000.
# Set this to your deployed URL if the scheduler should hit a live deployment
# instead of a local dev server.
DASHBOARD_URL=http://localhost:3000
